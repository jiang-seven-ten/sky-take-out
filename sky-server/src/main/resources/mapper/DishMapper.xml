<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">


    <insert id="insert" useGeneratedKeys = "true" keyProperty = "id">
        insert into dish (name,category_id,price,description,image,status,create_time,update_time,create_user,update_user)
        values
        (#{name},#{categoryId},#{price},#{description},#{image},#{status},#{createTime},#{updateTime},#{createUser},#{updateUser})
    </insert>


    <delete id="deleteBatch">
        delete from dish where id in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                #{id}
            </foreach>
    </delete>


<!--    根据菜品id更新菜品信息-->
    <update id="updateById">
        update dish
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="description != null and description != ''">
                description = #{description},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id}
    </update>


    <!-- 查询dish表中的所有字段并且自动封装到DishVO中，多余的字段不会封装也不会报错 -->
    <select id="list" resultType="com.sky.vo.DishVO">
        select d.*,c.name as categoryName
        from dish as d left join category as c on d.category_id=c.id
        <where>
            <if test="name!=null and name!=''">and d.name like concat('%',#{name},'%')</if>
            <if test="categoryId!=null">and d.category_id=#{categoryId}</if>
            <if test="status!=null">and d.status=#{status}</if>
        </where>
        order by d.create_time desc
    </select>




    <resultMap id="dishVOResultMap" type="com.sky.vo.DishVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="description" property="description"/>
        <result column="image" property="image"/>
        <result column="status" property="status"/>
        <result column="update_time" property="updateTime"/>

        <result column="category_id" property="categoryId"/>
        <result column="categoryName" property="categoryName"/>

        <!-- 讲一下这里的column属性，给column属性赋值的字段，我们会拿着这个字段进行子查询(这里没有子查询)，子查询我们一般写在select属性 -->
        <!-- 再把查询到的结果封装到flavors属性中 -->
        <collection property="flavors" column="id" ofType="com.sky.entity.DishFlavor">
            <id column="df_id" property="id"/>
            <result column="df_name" property="name"/>
            <result column="df_value" property="value"/>
            <result column="df_dish_id" property="dishId"/>
        </collection>
    </resultMap>
<!--    上面是自动配置的封装-->
    <select id="getInfoById" resultMap="dishVOResultMap">
        select d.*,c.name as categoryName,df.id as df_id,df.name as df_name, df.dish_id as df_dish_id,df.value as df_value
        from dish as d left join dish_flavor as df
            on d.id=df.dish_id
        left join category as c on d.category_id = c.id
        where d.id=#{id}
    </select>


</mapper>
